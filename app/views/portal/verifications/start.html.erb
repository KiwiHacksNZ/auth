<% content_for :title, "Get Verified" %>
<% content_for(:portal_wrapper, true) %>
<div class="container-sm">
  <% if portal_onboarding_scenario&.logo_path %>
    <div style="text-align: center; margin-bottom: 2rem;">
      <%= vite_image_tag portal_onboarding_scenario.logo_path, alt: "Logo", style: "height: 150px;" %>
    </div>
  <% end %>
  <article class="section-card" style="position: relative;">
    <h1>hey! <%= emoji_image "hyper-dino-wave-flip.gif" %></h1>
    <p>We're excited to have you at KiwiHacks!</p>
    <p>First, we need to verify you're 18 or under.</p>
    <p>KiwiHacks events and swag are free thanks to our sponsors, and with that comes people trying to slip in.</p>
    <p>This quick check helps us make sure our events stay for real high-school hackers.</p>

    <div class="status-actions">
      <%= link_to "alright! →", portal_verify_document_path, role: "button" %>
    </div>
  </article>
</div>
